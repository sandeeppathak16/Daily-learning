      "boundElements": null,
      "updated": 1790674131197,
      "created": 1790673083791,
      "link": null,
      "locked": false,
      "text": "Function requirement \n\n- user should be able to upload video\n- user should be able to stream video\n\nNon-functional requirement \n\n- High vailability\n- scalability \n- low latency streaming \n- support uploading/steaming for large video (256GB)\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Function requirement \n\n- user should be able to upload video\n- user should be able to stream video\n\nNon-functional requirement \n\n- High vailability\n- scalability \n- low latency streaming \n- support uploading/steaming for large video (256GB)\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
