      "updated": 1788771973113,
      "link": null,
      "locked": false,
      "text": "Primary → Replica 1 ✓\nPrimary → Replica 2 ✓\n\nResponse to User ✓\n\n✓ Latest Data Everywhere\n✓ Strong Consistency\n\n❌ Higher Latency\n❌ Slow Writes",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Primary → Replica 1 ✓\nPrimary → Replica 2 ✓\n\nResponse to User ✓\n\n✓ Latest Data Everywhere\n✓ Strong Consistency\n\n❌ Higher Latency\n❌ Slow Writes",
      "autoResize": true,
      "lineHeight": 1.25,
